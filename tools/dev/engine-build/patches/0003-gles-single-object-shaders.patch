+    // ---- GLES (gl4es on Android) shader fixups ------------------------------------------------
+    //
+    // Desktop GL lets a program carry several shader objects per stage, so OpenMW keeps shared
+    // implementations (lib/core/vertex.glsl, lighting_*_legacy.glsl, ...) in separate objects that
+    // are attached through `@link`. GLSL ES allows exactly one object per stage and each must have
+    // main(), so on a phone every world program fails with "no main() function" / "Call to
+    // undefined function". GLSL ES 1.00 also has no `centroid` and no uniform initializers.
+    //
+    // With fixups on, the linked sources are spliced into a private copy of the stage's main
+    // shader (see ShaderManager::addLinkedShaders), and every uniform declaration is wrapped in an
+    // include guard so a uniform declared both by the main shader and by a linked file (screenRes,
+    // near, sun, ...) is declared only once in the merged translation unit.
+    //
+    // On by default on Android; OPENMW_GLES_SHADER_FIXUPS=0 turns it off, =1 forces it elsewhere.
+    bool useGlesShaderFixups()
+    {
+        static const bool enabled = [] {
+            const char* env = std::getenv("OPENMW_GLES_SHADER_FIXUPS");
+#ifdef __ANDROID__
+            const bool enabledByDefault = true;
+#else
+            const bool enabledByDefault = false;
+#endif
+            if (env == nullptr || env[0] == '\0')
+                return enabledByDefault;
+            return env[0] != '0';
+        }();
+        return enabled;
+    }
+
+    void applyGlesShaderFixups(std::string& source, const std::string& templateName)
+    {
+        static const std::regex uniformDecl(
+            R"(^\s*uniform\s+((?:(?:lowp|mediump|highp)\s+)?[A-Za-z_][A-Za-z0-9_]*)\s+([A-Za-z_][A-Za-z0-9_]*)\s*(\[[^\]]*\])?\s*(=[^;]*)?;\s*(//.*)?$)");
+
+        std::string out;
+        out.reserve(source.size() + source.size() / 4);
+        size_t start = 0;
+        while (start <= source.size())
+        {
+            size_t end = source.find('\n', start);
+            const bool last = end == std::string::npos;
+            std::string line = source.substr(start, last ? std::string::npos : end - start);
+            if (!line.empty() && line.back() == '\r')
+                line.pop_back();
+
+            // `centroid varying` -> `varying`
+            size_t centroid = line.find("centroid varying");
+            if (centroid != std::string::npos)
+                line.erase(centroid, std::string_view("centroid ").size());
+
+            std::smatch match;
+            if (line.find("uniform") != std::string::npos && std::regex_match(line, match, uniformDecl))
+            {
+                const std::string type = match[1].str();
+                const std::string name = match[2].str();
+                const std::string array = match[3].str();
+                if (match[4].matched)
+                    Log(Debug::Warning) << "GLES: dropped initializer of uniform " << name << " in " << templateName;
+                const std::string guard = "OMW_GLES_UNIFORM_" + name;
+                out += "#ifndef " + guard + "\n#define " + guard + "\nuniform " + type + " " + name + array
+                    + ";\n#endif";
+            }
+            else
+                out += line;
+
+            if (last)
+                break;
+            out += '\n';
+            start = end + 1;
+        }
+        source = std::move(out);
+    }
+
+    std::string stripVersionDirective(const std::string& source)
+    {
+        std::string out;
+        out.reserve(source.size());
+        size_t start = 0;
+        while (start < source.size())
+        {
+            size_t end = source.find('\n', start);
+            if (end == std::string::npos)
+                end = source.size();
+            std::string_view line(source.data() + start, end - start);
+            size_t first = line.find_first_not_of(" \t");
+            if (first == std::string_view::npos || line.substr(first, 8) != "#version")
+                out.append(line);
+            out += '\n';
+            start = end + 1;
+        }
+        return out;
+    }
+
 }
 
